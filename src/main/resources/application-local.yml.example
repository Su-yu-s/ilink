# ============================================================
# 本地私有配置模板：复制本文件为 application-local.yml 后填入真实值。
#   PowerShell: Copy-Item application-local.yml.example application-local.yml
# application-local.yml 已被 .gitignore 忽略，不会进入版本库。
# 使用 ${环境变量:默认值} 写法：若设置了 AGNES_API_KEY 环境变量则以其为准，
# 否则使用冒号后的默认值；也可以完全不建本文件，只靠环境变量。
# ============================================================
app:
  ai:
    # Agnes（OpenAI 兼容）API Key，把冒号后替换为你自己的 Key
    api-key: ${AGNES_API_KEY:sk-在这里填入你的Key}
    # 国内节点 https://apihub.agnes-ai.cn/v1；国际站 https://apihub.agnes-ai.com/v1
    base-url: ${AGNES_BASE_URL:https://apihub.agnes-ai.cn/v1}
    # Agentic GraphRAG 向量服务（Qwen 文本向量，OpenAI 兼容接口，维度 1024）。
    # 未配置 Key 时向量检索自动降级为关键词检索，图谱问答仍可用。
    embedding:
      api-key: ${EMBEDDING_API_KEY:sk-在这里填入你的EmbeddingKey}
      base-url: ${EMBEDDING_BASE_URL:https://dashscope.aliyuncs.com/compatible-mode/v1}
      model: ${EMBEDDING_MODEL:qwen3.7-text-embedding-flash}
  # 反馈推送 / 密码重置邮件里拼详情链接用的公网地址，微信里必须能打开
  public-base-url: ${APP_PUBLIC_BASE_URL:https://ilink.work}

  feedback:
    # Server酱（https://sct.ftqq.com）SendKey，用于把意见反馈推送到开发者微信。
    # 留空则反馈照常落库并生成详情页，只是不推送。
    serverchan-sendkey: ${SERVERCHAN_SENDKEY:在这里填入你的SendKey}
