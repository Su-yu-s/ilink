# ============================================================
# iLink .gitignore
# ============================================================

# === IDE / 编辑器配置 ===
.idea/
*.iml
*.ipr
*.iws
.vscode/
.zcode/
.claude/

# === 构建产物 ===
target/
build/
out/
*.class
*.jar
*.war
!**/src/**/*.jar

# === 运行时数据 ===
uploads/
.pw-browsers/

# === 数据库备份与本地会话工具（含账号哈希/密码，绝不提交） ===
local_backup_*.sql
server_dump_*.sql
*.cookie
loadtestworkdircreator.cookie
.workbuddy/

# === 压测临时产物 ===
loadtest/workdir/
loadtest/*.log

# === Python 评测脚本的字节码缓存 ===
__pycache__/
*.pyc
*.pyo

# === 本地敏感配置（绝不提交） ===
src/main/resources/application-local.yml
src/main/resources/application-local.properties

# === 日志与崩溃转储 ===
*.log
logs/
日志.txt
*.stackdump
*.hprof

# === 内部文档与审计产物（绝不提交） ===
# docs/测试文档 含真实手机号与测试账号密码，
# docs/superpowers 部分设计稿也含真实账号信息；如需入库请先脱敏再用 git add -f
docs/
audit_results.json
corruption_report.txt

# === 本地临时产物归档（不入库） ===
# 整个目录都不提交。其中 logs/、scratch/、trailer/ 是随时可清的临时产物；
# backups/ 是数据库备份、secrets/ 是压测凭据，清理时务必保留
local-artifacts/
.tmp_*
__tmp_tools/
InspectIntent.*

# === 开发脚本与草稿（含真实测试账号密码，绝不提交） ===
# 该规则同时匹配 ai-agent/scripts/（e2e-smoke.mjs 内含 internal token）
scripts/
searchbar-demos/
screenshots/
# brainstorming 技能的本地草稿与预览产物
.superpowers/
# 宣传页 iLink-cn 的界面截图是正式交付内容，不忽略
!iLink-cn/screenshots/

# === 测试与覆盖率 ===
*.exec
coverage/
.nyc_output/
test_screenshots/

# === 系统文件 ===
.DS_Store
Thumbs.db
desktop.ini
*.tmp
*.tmp.*
*.bak
*~

# === ai-agent（pi 运行时） ===
ai-agent/node_modules/
ai-agent/workspace/
ai-agent/.env
ai-agent/*.log

# === 设计工作区（本地截图与 demo，不入库） ===
.oil-ui/
