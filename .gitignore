# ============================================================
# iLink .gitignore
# ============================================================

# === IDE / 编辑器配置 ===
.idea/
*.iml
*.ipr
*.iws
.vscode/
.zcode/
.claude/

# === 构建产物 ===
target/
build/
out/
*.class
*.jar
*.war
!**/src/**/*.jar

# === 运行时数据 ===
uploads/
.pw-browsers/

# === 数据库备份与本地会话工具（含账号哈希/密码，绝不提交） ===
local_backup_*.sql
server_dump_*.sql
*.cookie
loadtestworkdircreator.cookie
.workbuddy/

# === 压测临时产物 ===
loadtest/workdir/
loadtest/*.log

# === Python 评测脚本的字节码缓存 ===
__pycache__/
*.pyc
*.pyo

# === 本地敏感配置（绝不提交） ===
src/main/resources/application-local.yml
src/main/resources/application-local.properties

# === 日志与崩溃转储 ===
*.log
logs/
日志.txt
*.stackdump

# === 内部文档与审计产物 ===
docs/
PRODUCT.md
audit_results.json
corruption_report.txt

# === 本地临时产物归档（不入库，可整目录删除） ===
local-artifacts/
.tmp_*
InspectIntent.*

# === 开发脚本与草稿 ===
scripts/
searchbar-demos/
screenshots/
# brainstorming 技能的本地草稿与预览产物
.superpowers/
# 宣传页 iLink-cn 的界面截图是正式交付内容，不忽略
!iLink-cn/screenshots/

# === 测试与覆盖率 ===
*.exec
coverage/
.nyc_output/
test_screenshots/

# === 系统文件 ===
.DS_Store
Thumbs.db
desktop.ini
*.tmp
*.tmp.*
*.bak
*~
