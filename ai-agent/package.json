{
  "name": "ilink-ai-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "iLink 团队 Agent 运行时：基于 pi-agent-core，检索走 Java Agentic GraphRAG，办公文件读写走本地沙箱",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "start": "node src/server.js",
    "cli": "node src/index.js",
    "dev": "node --watch src/server.js",
    "check": "node --check src/server.js && node --check src/index.js",
    "smoke": "node scripts/e2e-smoke.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^1.5.0",
    "@earendil-works/pi-ai": "^1.5.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "docx": "^9.5.1",
    "exceljs": "^4.4.0",
    "pdf-lib": "^1.17.1",
    "pptxgenjs": "^4.0.1"
  }
}
